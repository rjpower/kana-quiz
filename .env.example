# Copy to .env and fill in as needed. Every value here is OPTIONAL — with an
# empty .env the app runs fully offline (LLM grading and TTS just hide
# themselves). Do NOT commit your real .env; it is gitignored.

# --- Auth gate (optional) ---------------------------------------------------
# If set, all /api/* requests require a signed cookie. Leave unset for an open
# instance on localhost / a trusted LAN.
KANA_AUTH_PASSWORD=
# HMAC secret for the auth cookie. Defaults to KANA_AUTH_PASSWORD if unset.
KANA_AUTH_SECRET=

# --- LLM free-text grading (optional) ---------------------------------------
# A Gemini API key enables semantic grading of typed answers.
GEMINI_API_KEY=

# --- Text-to-speech (optional, Google Cloud) --------------------------------
# Path (inside the container) to a service-account key with the Cloud
# Text-to-Speech API enabled, plus your GCP project id.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-tts.json
KANA_TTS_GCP_PROJECT=your-gcp-project-id
# Set to 1 to hard-disable TTS regardless of credentials.
KANA_TTS_DISABLED=
